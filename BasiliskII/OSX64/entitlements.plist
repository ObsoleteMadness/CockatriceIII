<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- JIT engines (amiberry, emu68). Adhoc/local builds only need these two. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!--
      Do NOT add com.apple.security.cs.disable-executable-page-protection here.
      AMFI SIGKILLs adhoc-signed dev binaries that claim it before main() runs.
    -->
</dict>
</plist>
